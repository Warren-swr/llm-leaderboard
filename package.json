{
  "name": "llm-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于公开自报与第三方评测分数的 LLM 榜单",
  "scripts": {
    "data": "tsx pipeline/build.ts",
    "check:data": "tsx pipeline/check.ts",
    "dev": "vite",
    "build": "tsc -b && vite build --base ./",
    "build:miaoda": "tsc -b && vite build --base ./ --mode miaoda",
    "preview": "vite preview --base ./"
  },
  "dependencies": {
    "@mantine/charts": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@tabler/icons-react": "^3.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "postcss": "^8.5.0",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.1"
  }
}
